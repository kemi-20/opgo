{
  "listen": ":3003",
  "providers": { // 多 provider 路由：每个模型通过 pricing 里的 provider 字段引用这里的名称
    "go": { // provider 名称（模型里填这个名字来引用）
      "url": "https://PROVIDER_HOST/v1", // 该 provider 的上游地址
      "key": "sk-REPLACE_ME" // 该 provider 的母 key
    },
    "zen": { // 第二个 provider 示例（可按需增删）
      "url": "https://PROVIDER_HOST_2/v1",
      "key": "sk-REPLACE_ME_2"
    }
  },
  "admin_password": "ADMIN_REPLACE_ME",
  "balance_interval_seconds": 120,
  "rate_limit_per_minute": 60,
  "boost": {
    "enabled": true, // 是否启用临期智能提额（提额状态仅存内存，重启后重新判断）
    "base_overage_percent": 105, // 正常硬卡 = 限额×105%（后台缓冲，防对话中途断；前端不显示）
    "trigger_percent": 90, // used ≥ 90%×当前档限额 时尝试提额
    "boost_percent": 150, // 提额到 当前档限额×150%（可多次提额：第1次150%×L，第2次150%×150%×L…）
    "pool_max_percent": 85, // 每次提额都要求总池实时余量 < 85%
    "other_window_max_percent": 95, // 每次提额都要求其他两个窗口 used/限额 < 95%
    "max_boost_times": 0 // 每个重置周期最多智能提额次数（0 = 不限；如 3 = 最多提到 150%^3×L）
  },
  "limits_per_user": {
    "5h": 2.40,
    "1w": 6.00,
    "1m": 12.00
  },
  "pricing": {
    "deepseek-v4-flash": { // 第一个模型：完整示例（演示所有可选字段）
      "provider": "go", // 引用 providers 里的名称；重复配置只取第一个
      "provider_model": "deepseek-v4-flash", // 上游实际请求的模型；留空或同名表示不改模型
      "input_per_million": 0.44, // 谷时价 = 官网 Off-Peak $0.22×2（$30 档 2x）；peak 时 opgo 再 ×2 = $0.88
      "output_per_million": 1.32, // 官网 Off-Peak $0.66×2；peak 时 $2.64
      "cached_read_per_million": 0.014, // 官网 Off-Peak $0.007×2；peak 时 $0.028
      "cached_write_per_million": 0,
      "context_length": 1000000, // 上下文/最大输出参考 models.dev 对应供应商页
      "max_output_tokens": 384000, // 单次最大输出 token
      "transformation": "", // 空=透传只替换认证
      "modality": "text->text", // 模态：输入->输出（空默认 text->text）
      "tag": "高峰期2x消耗", // 前端定价表模型名右侧显示的标签
      "peak": { // 模型级峰谷时配置（可空=不启用）：峰时自动加倍扣款，config 填谷时价
        "enabled": true,
        "multiplier": 2,
        "windows": [["01:00", "04:00"], ["06:00", "10:00"]]
      }
    },
    "deepseek-v4-flash-vision-exp": {
      "provider": "go",
      "input_per_million": 0.88,
      "output_per_million": 2.64,
      "cached_read_per_million": 0.028,
      "cached_write_per_million": 0,
      "context_length": 1000000,
      "max_output_tokens": 384000,
      "modality": "text+image->text",
      "tag": "高峰期2x消耗",
      "peak": {
        "enabled": true,
        "multiplier": 2,
        "windows": [["01:00", "04:00"], ["06:00", "10:00"]]
      }
    },
